# === SELQUET Bot — plantilla de variables (se commitea; NO pongas secretos acá) ===
# Copiar este archivo a .env y completar los valores reales en el .env.

# Flask
FLASK_SECRET_KEY=cambiame_por_algo_random

# Panel de administración (contraseña de acceso a /admin)
ADMIN_PASSWORD=cambiame

# Base de datos: por defecto SQLite local. Para producción cambiar a Postgres:
#   DATABASE_URL=postgresql://usuario:pass@host:5432/selquet
DATABASE_URL=sqlite:///./selquet.db

# Modelo de Claude (se puede cambiar sin tocar código)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# --- Proveedor de WhatsApp: meta | twilio (default: meta) ---
WHATSAPP_PROVIDER=meta

# Meta Cloud API (número de prueba de Meta for Developers)
WHATSAPP_VERIFY_TOKEN=selquet_prueba_123
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Twilio (fallback opcional — solo si WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WA_NUMBER=
# TWILIO_VERIFY_SIGNATURE=true

# URL pública del backend (en sandbox, la de ngrok). La usan el webhook de
# MercadoPago, los back_urls y el link del PDF de la carta.
PUBLIC_BASE_URL=https://groggily-suds-hesitate.ngrok-free.dev

# MercadoPago
# Para PRUEBAS usar credenciales TEST (TEST-...): no mueve plata real.
# El APP_USR-... es de PRODUCCIÓN y cobra de verdad. Cambiar de uno a otro es
# solo cambiar este valor. Si no ponés MP_BASE_URL, usa PUBLIC_BASE_URL.
MP_ACCESS_TOKEN=
MP_BASE_URL=

# Email (para avisar a los destinatarios de eventos). Ej. Gmail: host
# smtp.gmail.com, puerto 587, y una "contraseña de aplicación".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
